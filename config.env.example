# server-alerts — datos comunes a TODOS tus servidores.
#
# 1. Copia este archivo:   cp config.env.example config.env
# 2. Rellena config.env con tus datos (config.env está en .gitignore).
#
# install.sh lo copia a cada servidor y solo te pregunta el nombre de ese
# servidor. Si dejas los valores PEGA_AQUI_..., el instalador te los pedirá.

# Token que te da @BotFather (formato 123456789:AAxxxxxxxx...)
TELEGRAM_BOT_TOKEN="PEGA_AQUI_TU_TOKEN"

# Tu chat_id (número; en grupos empieza por -100...)
TELEGRAM_CHAT_ID="PEGA_AQUI_TU_CHAT_ID"

# Zona horaria de las alertas (lista: timedatectl list-timezones)
ALERT_TZ="Europe/Madrid"
